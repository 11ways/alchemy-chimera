{% extend "layouts/chimera_base" %}

<% style('chimera/chimera') %>

{% block "base" %}
<div class="chimera-wrapper">
	<div class="chimera-sidebar">
		<div class="chimera-page-header">
			
		</div>
		<%= Alchemy.segment('Chimera.Static#sidebar') %>
	</div>
	<div class="chimera-content">
		<div class="chimera-page-header">
			<div hidden>
				<div class="page-title" data-he-name="page-title"></div>
				<div class="page-notification" data-he-name="page-notification"></div>
				<div class="page-actions" data-he-name="page-actions"></div>
			</div>

			<al-editor-toolbar
				#toolbar_manager={% toolbar_manager %}
			>
				<div slot="left">
					<div class="page-title">
						<span data-toolbar="title"></span>
					</div>
					<div data-area="left-content"></div>
				</div>

				<div slot="center">
					<al-user-avatar-group
						class="watchers"
					></al-user-avatar-group>
				</div>

			<div slot="right">
				<al-button class="start-edit" state="ready">
					<al-icon icon-name="pencil"></al-icon>
					{%t "start-editing" %}
				</al-button>

				<al-button class="stop-and-save" state="ready">
					<al-state state-name="saving">
						<al-icon icon-name="spinner" icon-flags="spin"></al-icon>
						{%t "saving" %}
					</al-state>
					<al-state state-name="saving-before-stop">
						<al-icon icon-name="spinner" icon-flags="spin"></al-icon>
						{%t "saving" %}
					</al-state>
					<al-state state-name="saved">
						<al-icon icon-name="badge-check" icon-flags="beat"></al-icon>
						{%t "saved" %}
					</al-state>
					<al-state state-name="ready">
						<al-icon icon-name="floppy-disk-circle-arrow-right"></al-icon>
						{%t "save-and-stop-editing" %}
					</al-state>
				</al-button>

				<al-button class="stop-edit" state="ready">
					<al-icon icon-name="pencil-slash"></al-icon>
					{%t "stop-editing" %}
				</al-button>

				<al-button class="save-all" state="ready">
					<al-state state-name="saving">
						<al-icon icon-name="spinner" icon-flags="spin"></al-icon>
						{%t "saving" %}
					</al-state>
					<al-state state-name="saved">
						<al-icon icon-name="badge-check" icon-flags="beat"></al-icon>
						{%t "saved" %}
					</al-state>
					<al-state state-name="ready">
						<al-icon icon-name="floppy-disk"></al-icon>
						{%t "save-all" %}
					</al-state>
				</al-button>

				<div data-area="buttons"></div>
			</div>
			</al-editor-toolbar>

			{#
				<al-user-avatar
					#user={% Acl.data %}
				></al-user-avatar>
			#}
		</div>
		<div data-he-name="main" class="chimera-main">

		</div>
	</div>
</div>
{% /block %}